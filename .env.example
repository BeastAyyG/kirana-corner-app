# Kirana Corner — environment configuration
# Copy to `.env` for local development. Never commit `.env`.
# Production REQUIRES unique secrets of at least 32 characters (startup refuses otherwise).

# --- Runtime ---
NODE_ENV=development
HOST=127.0.0.1
PORT=3000

# --- Databases (SQLite files; WAL mode) ---
KIRANA_DB_PATH=./data/kirana.sqlite
KIRANA_V2_DB_PATH=./data/kirana-delivery.sqlite
# Set true to skip demo catalog/staff seeding on an empty delivery database:
# KIRANA_V2_SKIP_SEED=true

# --- Secrets (REQUIRED in production; generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))") ---
KIRANA_PICKUP_CODE_SECRET=replace-with-a-unique-secret-of-at-least-32-characters
KIRANA_SESSION_SECRET=replace-with-a-different-unique-secret-of-at-least-32-characters

# --- OTP / sign-in ---
# console = log codes to server console (development only). msg91 | twilio = real SMS.
KIRANA_OTP_PROVIDER=console
# Allow console OTP even when NODE_ENV=production (staging demos only; never real production):
# KIRANA_ALLOW_CONSOLE_OTP=true
# Force dev_code in verify responses regardless of provider (development only):
# KIRANA_OTP_DEV=true
KIRANA_MSG91_AUTHKEY=
KIRANA_MSG91_TEMPLATE_ID=
KIRANA_TWILIO_ACCOUNT_SID=
KIRANA_TWILIO_AUTH_TOKEN=
KIRANA_TWILIO_VERIFY_SERVICE_SID=

# --- Sessions ---
KIRANA_SESSION_DAYS=30
# Set true when serving v1 over HTTPS (Secure cookie flag):
# KIRANA_COOKIE_SECURE=true

# --- Payments ---
# mock = built-in dev provider (confirm endpoint + signed webhook). razorpay = real Razorpay.
KIRANA_PAYMENT_PROVIDER=mock
KIRANA_RAZORPAY_KEY_ID=
KIRANA_RAZORPAY_KEY_SECRET=
KIRANA_RAZORPAY_WEBHOOK_SECRET=

# --- Delivery operations ---
KIRANA_RIDER_OFFER_SECONDS=60
KIRANA_RIDER_MAX_ACTIVE_JOBS=2
KIRANA_AVG_SPEED_KMPH=18

# --- CORS (comma-separated origins allowed to call /api/v2 from browsers; empty = same-origin only) ---
# Example for local frontend dev servers:
# KIRANA_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
KIRANA_CORS_ORIGINS=